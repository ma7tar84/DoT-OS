# =============================================================================
# DoT OS — core macOS (Aqua / Cupertino) desktop defaults
# Applied system-wide via gschema overrides (compiled into
# /usr/share/glib-2.0/schemas/ at build time). These are *system defaults*:
# every user gets the macOS layout out of the box, and changes made later in
# GNOME Settings still win (dconf user values take precedence over
# system overrides).
#
# All schemas below verified to exist at build time (gsettings-desktop-schemas
# + the two extensions the gnome-extensions module installs BEFORE this module):
#   org.gnome.desktop.interface           (non-relocatable)
#   org.gnome.desktop.wm.preferences      (RELOCATABLE -> path=
#                                          /org/gnome/desktop/wm/preferences/,
#                                          so the [..:GNOME-Greeter] subpath
#                                          override below is legal)
#   org.gnome.shell.extensions.user-theme (User Themes extension)
# =============================================================================

[org.gnome.desktop.interface]
# macOS look: WhiteSur GTK theme, WhiteSur icons, Inter typeface (closest free
# stand-in for Apple's San Francisco).
# NOTE: `gtk-theme-dark` is NOT a valid key in org.gnome.desktop.interface —
# it does not exist and the strict schema check rejects it (exits on first bad
# key). WhiteSur-Light ships BOTH the light and dark CSS inside one theme;
# GNOME's `color-scheme` key selects the variant, so we point gtk-theme at
# WhiteSur-Light once and set color-scheme (prefer-light = macOS Aqua default).
gtk-theme='WhiteSur-Light'
color-scheme='prefer-light'
icon-theme='WhiteSur'
font-name='Inter'
enable-animations=true

[org.gnome.desktop.wm.preferences]
# macOS-style window controls: minimize, maximize, close — TOP-LEFT corner
button-layout='minimize,maximize,close:'

[org.gnome.desktop.wm.preferences:GNOME-Greeter]
button-layout='minimize,maximize,close:'

[org.gnome.shell.extensions.user-theme]
# WhiteSur GNOME Shell (Aqua) theme. The theme files live in
# /usr/share/themes/WhiteSur-Light/gnome-shell/ and the User Themes extension
# loads them from ~/.themes/ — the dot-os-shell-theme.service user unit
# symlinks the system theme into ~/.themes automatically (no user action).
name='WhiteSur-Light'
